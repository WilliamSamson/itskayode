{
  "hosting": [
    {
      "site": "itskayode",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/cv/kayode-olalere-cv.pdf",
          "destination": "/cv",
          "type": 302
        },
        {
          "source": "/fun{,/**}",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/projects/acauide-flutter-app{,/**}",
          "destination": "/projects",
          "type": 301
        },
        {
          "source": "/projects/itskayode-portfolio{,/**}",
          "destination": "/projects",
          "type": 301
        },
        {
          "source": "/projects/medswift-emergencynet{,/**}",
          "destination": "/projects",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/p/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    },
    {
      "site": "xritskayode",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://itskayode.web.app",
          "type": 301
        }
      ]
    }
  ]
}
